# 后端配置。**运行时**读取，改了重启即可生效。
# 前端的 VITE_BASE_PATH 不是这样 —— 它是构建时写死的，改了必须重新 build。

NODE_ENV=development

# 只绑 127.0.0.1，外部流量一律经 nginx 反代进来
PORT=3100

# 接口路径前缀。站点挂根路径，接口在 /api/，与前端同域，不需要 CORS
API_PREFIX=api

# 站点对外地址。换域名或换端口时，整个后端只有这一个值要改
# （另一处是 nginx 的 listen / server_name）。前端不需要重新构建。
# 本地开发填 vite dev server 的地址
APP_ORIGIN=http://localhost:5173

# --- 数据库 ---
# 本地开发指向 docker-compose.dev.yml 起的容器（npm run db:up）
DATABASE_URL="postgresql://h5tools:h5tools_dev@127.0.0.1:54320/h5tools?schema=public"
# 测试库必须与业务库分开：测试按用例回滚，跑在业务库上会清掉正在看的数据
DATABASE_URL_TEST="postgresql://h5tools:h5tools_dev@127.0.0.1:54320/h5tools_test?schema=public"

# --- Redis ---
# session、天气缓存、限流都放这里。
# ⚠ 这是一台**共享** Redis，上面有别的项目在跑。所有 key 靠前缀隔离，
#   绝不要对它执行 flushdb/flushall。
REDIS_URL="redis://:密码@内网地址:6379"
REDIS_KEY_PREFIX="h5tools-dev:"

# 测试会按前缀批量删 key，前缀必须与上面不同。
# 可以指向同一台 Redis —— 隔离靠的是前缀，不是库号。
REDIS_URL_TEST="redis://:密码@内网地址:6379"
REDIS_KEY_PREFIX_TEST="h5tools-test:"

# --- 天气数据源凭据 ---
# 三个凭据缺任意一个会启动即失败，不会带着空凭据跑起来。
# 申请入口见 docs/contexts/weather/CONTEXT.md
QWEATHER_API_HOST=
QWEATHER_API_KEY=
# 走哪版和风接口：v1(默认)或 v7。v7 已被上游标记弃用，两份实现都在
# src/weather/providers/qweather/ 下，v1 出问题时改这个变量即可回滚，不必回滚代码。
# 只接受这两个值，写错会启动失败（不会静默退回默认值）。
QWEATHER_API_VERSION=v1
CAIYUN_TOKEN=

# --- 天气缓存与限流（都走 Redis）---
WEATHER_CACHE_TTL_SECONDS=1800
# 全部数据源都失败时用的短 TTL
WEATHER_CACHE_FAILURE_TTL_SECONDS=60
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=30
GEO_CACHE_TTL_SECONDS=86400
GEO_THROTTLE_TTL_MS=60000
# 这是 /geo/reverse、/geo/search、/geo/top 各自的额度，合计是它的 3 倍
GEO_THROTTLE_LIMIT=20
