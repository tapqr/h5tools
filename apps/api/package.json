{
  "name": "@h5tools/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b ../../packages/shared && prisma generate && nest build",
    "dev": "tsc -b ../../packages/shared && prisma generate && nest start --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.ts\"",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "user": "npm run build && node dist/cli/user.js",
    "user:create": "npm run user -- create",
    "user:passwd": "npm run user -- passwd",
    "user:list": "npm run user -- list",
    "user:seed": "npm run user -- seed",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@h5tools/shared": "*",
    "@keyv/redis": "^5.1.6",
    "@nestjs/axios": "^12.0.1",
    "@nestjs/cache-manager": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/throttler": "^6.7.0",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "axios": "^1.20.0",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "ioredis": "^6.0.0",
    "keyv": "^5.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "oxlint": "^1.58.0",
    "prisma": "^7.10.0",
    "supertest": "^7.0.0"
  }
}
